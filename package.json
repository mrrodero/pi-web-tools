{
  "name": "pi-web-tools",
  "description": "Web capability extension for pi: SearXNG web search, headless-browser rendering, bounded same-domain crawling, and a local corpus index (SQLite FTS5 + MiniLM embeddings) schema-compatible with dsh-web-tools",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrrodero/pi-web-tools.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "integration": "tsx tests/integration.ts",
    "harness": "tsx tests/harness.ts"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "cheerio": "^1.0.0",
    "onnxruntime-node": "^1.19.0",
    "playwright": "1.63.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.21.0": true
  }
}
