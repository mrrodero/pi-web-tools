# /etc/cron.d/searxng-harvest
#
# Installs the observability harvest as a root cron job on the search host.
#
#   ssh root@192.168.144.120 'cat > /opt/docker/llm/searxng/harvest/harvest.sh && chmod 755 /opt/docker/llm/searxng/harvest/harvest.sh' < harvest.sh
#   ssh root@192.168.144.120 'cat > /etc/cron.d/searxng-harvest && chmod 644 /etc/cron.d/searxng-harvest' < cron.d.example
#   ssh root@192.168.144.120 '/opt/docker/llm/searxng/harvest/harvest.sh'   # one manual run, to see output
#
# cron.d needs the extra *user* field (crontab -e does not). `run-parts` skips
# files with unusual names or permissions, so keep this file 644 and named
# searxng-harvest — no dots, no dashes-at-start.
#
# 15 minutes is the right cadence for this: `journalctl --cursor` makes each run
# cost one scan of the last interval, and /stats/errors percentages are relative
# to instance start, so it is the snapshots over time that become a trend.
#
# Do NOT schedule scripts/engine-health.ts: its probes send real queries to real
# engines, and doing that unattended is how you get rate-limited — which is
# exactly the failure it is trying to measure. Run it by hand, or after a harvest
# run you decide is interesting.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# The leading `. file` sources OPEN_METRICS_PASSWORD from a root-only (mode 600)
# file, so the password never appears in git or in the crontab itself. It must
# equal `general.open_metrics` in settings.yml; harvest.sh sends it as HTTP
# Basic auth (webapp.py:1182 reads the Authorization header, not a query param).
# With the variable unset the /metrics snapshot is skipped and the other three
# record kinds still land.
*/15 * * * * root . /opt/docker/llm/searxng/harvest/harvest.env; /opt/docker/llm/searxng/harvest/harvest.sh >> /var/log/searxng-harvest.log 2>&1
